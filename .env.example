# Tagged release builds embed both feeds automatically; set these only for local feed tests.
VITE_CIRAVA_UPDATE_MANIFEST_URL=
VITE_CIRAVA_STABLE_MANIFEST_URL=
VITE_CIRAVA_BETA_RELEASES_API_URL=
VITE_CIRAVA_APP_VERSION=1.0.0
VITE_CIRAVA_APP_CHANNEL=beta

# Real-account E2E is opt-in. Keep these values local and never commit secrets.
# CIRAVA_RUN_REAL_E2E=1
# CIRAVA_E2E_CLIENT_ID=1234567890-example.apps.googleusercontent.com
# CIRAVA_E2E_CLIENT_SECRET=local-value-from-the-downloaded-desktop-credentials-json
# CIRAVA_E2E_DATA_DIR=.cirava-e2e-data
# CIRAVA_E2E_FIXTURE=.cirava-e2e-data/cirava-e2e-fixture.bin
